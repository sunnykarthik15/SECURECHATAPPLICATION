# =========================================================
# Secure Chat Application - Environment Configuration Template
# Copy this file to .env and configure for your local environment
# =========================================================

# Flask Secret Key for Session Cookie Signing (Use >= 32 characters in production)
SECRET_KEY=replace-with-a-secure-random-32-byte-string-in-production

# Comma-separated list of allowed CORS origins for REST and Socket.IO
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Database URI (SQLite instance path)
DATABASE_URL=sqlite:///instance/chat.db

# Flask Environment (development / production)
FLASK_ENV=development
